APP_ENV=development
SEED_DATASET=development
DATABASE_URL=postgresql://rabsong:rabsong_dev@localhost:5436/rabsong?schema=public
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# ใช้เฉพาะคำสั่ง npm run owner:create บนระบบจริง ห้ามใส่รหัสพัฒนา
# OWNER_NAME=
# OWNER_PHONE=
# OWNER_PASSWORD=
# CREATE_DRIVER=true

# เว้นว่างไว้จนกว่าจะมีเซิร์ฟเวอร์ของตัวเอง ห้ามใส่เซิร์ฟเวอร์สาธารณะเป็นค่าเริ่มต้น
# OSRM_BASE_URL=http://127.0.0.1:5000
# VROOM_BASE_URL=http://127.0.0.1:3000
# GEOCODER_BASE_URL=http://127.0.0.1:8080
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# พุชและ SMS เว้นว่างไว้จนกว่าจะมีบัญชีของผู้ให้บริการเอง ห้ามใส่คีย์จริงในไฟล์นี้
# PUSH_PROVIDER_URL=
# PUSH_PROVIDER_KEY=
# SMS_PROVIDER_URL=
# SMS_PROVIDER_KEY=
