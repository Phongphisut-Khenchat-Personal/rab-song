generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  DRIVER
  GUARDIAN
}

enum RunPeriod {
  MORNING
  EVENING
}

enum RunStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StudentRunStatus {
  WAITING
  BOARDED
  ALIGHTED
  NO_SHOW
  EXCUSED
}

enum AttendanceEventType {
  BOARD
  ALIGHT
  NO_SHOW
  EXCUSE
  DELAY
  ALTERNATE_RECEIVER
  CORRECTION
}

enum AbsenceStatus {
  SUBMITTED
  ACKNOWLEDGED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
}

enum PaymentMethod {
  CASH
  TRANSFER
  OTHER
}

enum NotificationChannel {
  IN_APP
  WEB_PUSH
}

enum NotificationDelivery {
  PENDING
  RECORDED
  SENT
  NOT_CONFIGURED
  FAILED
}

enum CheckpointKind {
  ARRIVED_SCHOOL
  LEFT_SCHOOL
  RUN_FINISHED
}

enum SyncOperationType {
  ATTENDANCE
  ABSENCE
}

enum SyncOperationStatus {
  APPLIED
  REJECTED
}

enum LeadStatus {
  LEAD
  SURVEY_SCHEDULED
  LOCATION_PENDING_VERIFICATION
  ROUTE_ASSESSMENT
  QUOTE_PENDING
  AGREEMENT_PENDING
  REGISTRATION_PENDING
  SCHEDULE_PENDING
  READY_FOR_SERVICE
  ACTIVE
  REJECTED
  CANCELLED
  SUSPENDED
}

enum StudentServiceStatus {
  DRAFT
  NEEDS_VERIFICATION
  VERIFIED
  ACTIVE
  SUSPENDED
  ENDED
}

enum LocationStatus {
  UNVERIFIED
  PARENT_CONFIRMED
  FIELD_VERIFIED
  REJECTED
  NEEDS_RECHECK
}

enum CoordinateSource {
  MANUAL_ENTRY
  MAP_PIN
  GEOCODER
}

enum AgreementStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RouteVersionStatus {
  DRAFT
  LOCKED
  PUBLISHED
  SUPERSEDED
}

enum EstimateStatus {
  UNAVAILABLE
  ESTIMATED
}

enum ServiceExceptionKind {
  HOLIDAY
  SCHOOL_TIME_CHANGE
  VEHICLE_UNAVAILABLE
  DRIVER_UNAVAILABLE
}

enum InspectionKind {
  PRE_TRIP
  EMPTY_SWEEP
}

enum TripDisposition {
  NOT_PRESENT
  ABSENCE_CONFIRMED
  NOT_BOARDED
  BOARDED
  DROPPED_OFF
  HANDED_TO_AUTHORIZED_PERSON
  UNKNOWN
}

model User {
  id           String         @id @default(cuid())
  phone        String         @unique
  name         String
  passwordHash String
  role         UserRole
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  driver       Driver?
  guardian     Guardian?
  sessions     Session[]
  notifications Notification[]
  auditLogs     AuditLog[]
  leadsCreated  ServiceLead[]       @relation("LeadCreator")
  placesVerified Place[]            @relation("PlaceVerifier")
  exceptionsCreated ServiceException[] @relation("ExceptionCreator")
  inspections   VehicleInspection[] @relation("InspectionActor")
  impacts       RouteImpact[]       @relation("ImpactActor")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Driver {
  id        String        @id @default(cuid())
  userId    String        @unique
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  runs      ScheduleRun[]
}

model Guardian {
  id        String             @id @default(cuid())
  userId    String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  students  StudentGuardian[]
  absences  AbsenceRequest[]
}

model School {
  id        String    @id @default(cuid())
  name      String
  address   String
  latitude  Decimal?  @db.Decimal(9, 6)
  longitude Decimal?  @db.Decimal(9, 6)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]
  routes    Route[]
}

model Vehicle {
  id          String   @id @default(cuid())
  plateNumber String   @unique
  label       String
  capacity    Int
  driverId    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  driver      Driver   @relation(fields: [driverId], references: [id])
  routes      Route[]
}

model Student {
  id                    String                   @id @default(cuid())
  prefix                String
  firstName             String
  lastName              String
  nickname              String
  schoolId              String
  emergencyContactName  String
  emergencyContactPhone String
  allergyNote           String?
  gradeLevel            String?
  serviceStart          DateTime?                @db.Date
  serviceEnd            DateTime?                @db.Date
  serviceStatus         StudentServiceStatus     @default(ACTIVE)
  consentAt             DateTime?
  usesMorning           Boolean                  @default(true)
  usesEvening           Boolean                  @default(true)
  active                Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  school                School                   @relation(fields: [schoolId], references: [id])
  guardians             StudentGuardian[]
  assignments           StudentRouteAssignment[]
  runStates             StudentRunState[]
  events                AttendanceEvent[]
  absences              AbsenceRequest[]
  tripEvents         StudentTripEvent[]
  invoices              Invoice[]
  authorizedReceivers   AuthorizedPickupPerson[]
  lead                  ServiceLead?
}

model StudentGuardian {
  studentId    String
  guardianId   String
  relationship String
  isPrimary    Boolean  @default(false)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model Route {
  id          String                   @id @default(cuid())
  name        String
  schoolId    String
  vehicleId   String
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  school      School                   @relation(fields: [schoolId], references: [id])
  vehicle     Vehicle                  @relation(fields: [vehicleId], references: [id])
  stops       RouteStop[]
  schedules   Schedule[]
  assignments StudentRouteAssignment[]
  versions    RouteVersion[]
  impacts     RouteImpact[]
}

model RouteStop {
  id                 String                   @id @default(cuid())
  routeId            String
  name               String
  sequence           Int
  address            String
  latitude           Decimal?                 @db.Decimal(9, 6)
  longitude          Decimal?                 @db.Decimal(9, 6)
  route              Route                    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupAssignments  StudentRouteAssignment[] @relation("PickupStop")
  dropoffAssignments StudentRouteAssignment[] @relation("DropoffStop")
  place              Place?

  @@unique([routeId, sequence])
}

model StudentRouteAssignment {
  id            String    @id @default(cuid())
  studentId     String
  routeId       String
  pickupStopId  String
  dropoffStopId String
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  student       Student   @relation(fields: [studentId], references: [id])
  route         Route     @relation(fields: [routeId], references: [id])
  pickupStop    RouteStop @relation("PickupStop", fields: [pickupStopId], references: [id])
  dropoffStop   RouteStop @relation("DropoffStop", fields: [dropoffStopId], references: [id])

  @@unique([studentId, routeId])
}

model Schedule {
  id               String      @id @default(cuid())
  routeId          String
  period           RunPeriod
  dayOfWeek        Int
  plannedStartTime String
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  route            Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  runs             ScheduleRun[]

  @@unique([routeId, period, dayOfWeek])
}

model ScheduleRun {
  id          String            @id @default(cuid())
  scheduleId  String
  serviceDate DateTime          @db.Date
  status      RunStatus         @default(PLANNED)
  driverId    String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  schedule    Schedule          @relation(fields: [scheduleId], references: [id])
  driver      Driver            @relation(fields: [driverId], references: [id])
  states      StudentRunState[]
  events      AttendanceEvent[]
  checkpoints RunCheckpoint[]
  snapshots   RunStopSnapshot[]
  inspections VehicleInspection[]
  tripEvents  StudentTripEvent[]

  @@unique([scheduleId, serviceDate])
  @@index([serviceDate])
}

model StudentRunState {
  id                    String           @id @default(cuid())
  runId                 String
  studentId             String
  status                StudentRunStatus @default(WAITING)
  disposition           TripDisposition  @default(UNKNOWN)
  pickupStopId          String?
  dropoffStopId         String?
  alternateReceiverName String?
  updatedAt             DateTime         @updatedAt
  run                   ScheduleRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  student               Student          @relation(fields: [studentId], references: [id])

  @@unique([runId, studentId])
}

model AttendanceEvent {
  id                    String              @id @default(cuid())
  runId                 String
  studentId             String
  eventType             AttendanceEventType
  idempotencyKey        String              @unique
  note                  String?
  alternateReceiverName String?
  previousStatus        StudentRunStatus?
  nextStatus            StudentRunStatus?
  recordedByUserId      String
  recordedAt            DateTime            @default(now())
  clientRecordedAt      DateTime?
  run                   ScheduleRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  student               Student             @relation(fields: [studentId], references: [id])

  @@index([runId, studentId])
}

model AbsenceRequest {
  id              String        @id @default(cuid())
  studentId       String
  guardianId      String
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  reason          String
  affectsMorning  Boolean       @default(true)
  affectsEvening  Boolean       @default(true)
  status          AbsenceStatus @default(SUBMITTED)
  idempotencyKey  String        @unique
  late            Boolean       @default(false)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  student         Student       @relation(fields: [studentId], references: [id])
  guardian        Guardian      @relation(fields: [guardianId], references: [id])

  @@index([studentId, startDate, endDate])
}

model Notification {
  id               String                 @id @default(cuid())
  recipientUserId  String
  studentId        String?
  type             String
  title            String
  body             String
  channel          NotificationChannel
  delivery         NotificationDelivery
  pushDelivery     NotificationDelivery   @default(NOT_CONFIGURED)
  sourceEventId    String?
  createdAt        DateTime               @default(now())
  deliveredAt      DateTime?
  lastError        String?
  recipient        User                   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
}

model Invoice {
  id           String        @id @default(cuid())
  studentId    String
  yearMonth    String
  amountSatang Int
  status       InvoiceStatus @default(UNPAID)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  student      Student       @relation(fields: [studentId], references: [id])
  payments     Payment[]

  @@unique([studentId, yearMonth])
}

model Payment {
  id               String        @id @default(cuid())
  invoiceId        String
  amountSatang     Int
  method           PaymentMethod
  paidAt           DateTime
  recordedByUserId String
  note             String?
  idempotencyKey   String        @unique
  createdAt        DateTime      @default(now())
  invoice          Invoice       @relation(fields: [invoiceId], references: [id])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  previousJson Json?
  nextJson     Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model RunCheckpoint {
  id              String         @id @default(cuid())
  runId           String
  kind            CheckpointKind
  passed          Boolean
  missingJson     Json
  checkedByUserId String
  checkedAt       DateTime       @default(now())
  run             ScheduleRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, kind])
}

model SyncInbox {
  id              String              @id @default(cuid())
  userId          String
  idempotencyKey  String              @unique
  operationType   SyncOperationType
  payload         Json
  status          SyncOperationStatus
  result          Json?
  errorCode       String?
  clientCreatedAt DateTime?
  createdAt       DateTime            @default(now())
  appliedAt       DateTime?
}

model ServiceLead {
  id              String     @id @default(cuid())
  guardianName    String
  phone           String
  childNickname   String
  schoolName      String
  status          LeadStatus @default(LEAD)
  note            String?
  assessmentNote  String?
  rejectionReason String?
  quotedSatang    Int?
  scheduledAt     DateTime?
  studentId       String?    @unique
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  createdBy       User       @relation("LeadCreator", fields: [createdByUserId], references: [id])
  student         Student?   @relation(fields: [studentId], references: [id])
  surveys         ServiceSurvey[]
  place           Place?
  agreement       ServiceAgreement?

  @@index([status])
}

model ServiceSurvey {
  id          String      @id @default(cuid())
  leadId      String
  scheduledAt DateTime
  note        String?
  createdAt   DateTime    @default(now())
  lead        ServiceLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model ServiceAgreement {
  id           String          @id @default(cuid())
  leadId       String          @unique
  quotedSatang Int
  note         String?
  status       AgreementStatus @default(PENDING)
  acceptedAt   DateTime?
  createdAt    DateTime        @default(now())
  lead         ServiceLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Place {
  id                String           @id @default(cuid())
  label             String
  addressLine       String
  directionNote     String?
  entranceNote      String?
  parkingNote       String?
  landmark          String?
  cautionNote       String?
  latitude          Decimal?         @db.Decimal(9, 6)
  longitude         Decimal?         @db.Decimal(9, 6)
  geog              Unsupported("geography(Point,4326)")?
  coordinateSource  CoordinateSource @default(MANUAL_ENTRY)
  status            LocationStatus   @default(UNVERIFIED)
  checkNote         String?
  verifiedByUserId  String?
  verifiedAt        DateTime?
  leadId            String?          @unique
  routeStopId       String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  verifiedBy        User?            @relation("PlaceVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  lead              ServiceLead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  routeStop         RouteStop?       @relation(fields: [routeStopId], references: [id], onDelete: SetNull)

  @@index([status])
}

model AuthorizedPickupPerson {
  id           String   @id @default(cuid())
  studentId    String
  name         String
  relationship String
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, active])
}

model RouteVersion {
  id                      String             @id @default(cuid())
  routeId                 String
  number                  Int
  status                  RouteVersionStatus @default(DRAFT)
  schoolDeadline          String
  dwellSeconds            Int                @default(60)
  estimateStatus          EstimateStatus     @default(UNAVAILABLE)
  distanceMeters          Int?
  durationSeconds         Int?
  estimateNote            String?
  acceptUnverifiedTiming  Boolean            @default(false)
  lockedAt                DateTime?
  publishedAt             DateTime?
  createdAt               DateTime           @default(now())
  route                   Route              @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stops                   RouteVersionStop[]

  @@unique([routeId, number])
  @@index([routeId, status])
}

model RouteVersionStop {
  id          String       @id @default(cuid())
  versionId   String
  routeStopId String
  sequence    Int
  version     RouteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, sequence])
  @@unique([versionId, routeStopId])
}

model RouteImpact {
  id               String   @id @default(cuid())
  routeId          String
  reason           String
  unchangedRunIds  Json
  actorUserId      String
  createdAt        DateTime @default(now())
  route            Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  actor            User     @relation("ImpactActor", fields: [actorUserId], references: [id])

  @@index([routeId, createdAt])
}

model RunStopSnapshot {
  id          String      @id @default(cuid())
  runId       String
  routeStopId String
  sequence    Int
  name        String
  run         ScheduleRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId])
}

model ServiceException {
  id              String               @id @default(cuid())
  serviceDate     DateTime             @db.Date
  kind            ServiceExceptionKind
  affectsMorning  Boolean              @default(true)
  affectsEvening  Boolean              @default(true)
  note            String
  createdByUserId String
  createdAt       DateTime             @default(now())
  createdBy       User                 @relation("ExceptionCreator", fields: [createdByUserId], references: [id])

  @@unique([serviceDate, kind])
}

model VehicleInspection {
  id               String         @id @default(cuid())
  runId            String
  kind             InspectionKind
  items            Json
  passed           Boolean
  idempotencyKey   String         @unique
  note             String?
  checkedByUserId  String
  checkedAt        DateTime       @default(now())
  run              ScheduleRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  checkedBy        User           @relation("InspectionActor", fields: [checkedByUserId], references: [id])

  @@index([runId, kind])
}

model StudentTripEvent {
  id                   String          @id @default(cuid())
  runId                String
  studentId            String
  disposition          TripDisposition
  idempotencyKey       String          @unique
  note                 String?
  receiverName         String?
  previousDisposition  TripDisposition?
  nextDisposition      TripDisposition
  recordedByUserId     String
  recordedAt           DateTime        @default(now())
  clientRecordedAt     DateTime?
  run                  ScheduleRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  student              Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([runId, studentId])
}

model OperatingPolicy {
  id                        String   @id @default("default")
  absenceCutoffTime         String   @default("21:00")
  noShowContactInstruction  String
  noReceiverInstruction     String
  updatedAt                 DateTime @updatedAt
}
